# Copy to .env for local use. Never commit the real .env file.
LLM_MODE=ollama                      # ollama | offline
OLLAMA_BASE_URL=http://ollama:11434  # use http://localhost:11434 when running without Docker
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b
TOP_K=3
API_KEY=change-me                    # clients must send this in the X-API-Key header
